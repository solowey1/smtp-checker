    "starttls",
    "tls",
    "diagnostics",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "solowey1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solowey1/smtp-checker.git"
  },
  "bugs": {
    "url": "https://github.com/solowey1/smtp-checker/issues"
  },
  "homepage": "https://github.com/solowey1/smtp-checker#readme",
  "main": "index.js",
  "bin": {
    "smtp-checker": "bin/smtp-checker.js"
  },
  "files": [
    "bin",
    "src",
    "index.js",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
