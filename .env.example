# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Copy to .env and fill in. The .env file is git-ignored.

# Пресет провайдера (--list покажет все ключи). Необязателен, если логин — e-mail.
# Provider preset (see --list). Optional when the login is an e-mail address.
SMTP_PROVIDER=yandex

# Либо сервер вручную. / Or set the server explicitly.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true

SMTP_USER=you@example.com
SMTP_PASS=your-app-password

# Необязательно. / Optional.
# SMTP_FROM=you@example.com
# SMTP_TO=someone@example.com
# SMTP_AUTH=PLAIN
# SMTP_TIMEOUT=20000
